store(&VERSION) "10.0"
store(&NAME) "Qazaq Latin N"
store(&KEYBOARDVERSION) "1.0"
store(&TARGETS) "any"
store(&COPYRIGHT) "Qazaq Translit"
store(&LAYOUTFILE) "qazaq_latin_n.keyman-touch-layout"

begin Unicode > use(main)

group(main) using keys

+ [K_Q] > 'q'
+ [SHIFT K_Q] > 'Q'
+ [K_E] > 'e'
+ [SHIFT K_E] > 'E'
+ [K_R] > 'r'
+ [SHIFT K_R] > 'R'
+ [K_T] > 't'
+ [SHIFT K_T] > 'T'
+ [K_Y] > 'y'
+ [SHIFT K_Y] > 'Y'
+ [K_U] > 'u'
+ [SHIFT K_U] > 'U'
+ [U_0130] > 'i'
+ [SHIFT U_0130] > 'İ'
+ [K_O] > 'o'
+ [SHIFT K_O] > 'O'
+ [U_00D6] > 'ö'
+ [SHIFT U_00D6] > 'Ö'
+ [K_P] > 'p'
+ [SHIFT K_P] > 'P'
+ [K_A] > 'a'
+ [SHIFT K_A] > 'A'
+ [U_00C4] > 'ä'
+ [SHIFT U_00C4] > 'Ä'
+ [K_S] > 's'
+ [SHIFT K_S] > 'S'
+ [U_015E] > 'ş'
+ [SHIFT U_015E] > 'Ş'
+ [K_D] > 'd'
+ [SHIFT K_D] > 'D'
+ [K_F] > 'f'
+ [SHIFT K_F] > 'F'
+ [K_G] > 'g'
+ [SHIFT K_G] > 'G'
+ [U_011E] > 'ğ'
+ [SHIFT U_011E] > 'Ğ'
+ [K_H] > 'h'
+ [SHIFT K_H] > 'H'
+ [K_J] > 'j'
+ [SHIFT K_J] > 'J'
+ [K_K] > 'k'
+ [SHIFT K_K] > 'K'
+ [K_L] > 'l'
+ [SHIFT K_L] > 'L'
+ [K_Z] > 'z'
+ [SHIFT K_Z] > 'Z'
+ [K_V] > 'v'
+ [SHIFT K_V] > 'V'
+ [K_B] > 'b'
+ [SHIFT K_B] > 'B'
+ [K_N] > 'n'
+ [SHIFT K_N] > 'N'
+ [U_00D1] > 'ñ'
+ [SHIFT U_00D1] > 'Ñ'
+ [K_M] > 'm'
+ [SHIFT K_M] > 'M'
+ [U_016A] > 'ū'
+ [SHIFT U_016A] > 'Ū'
+ [U_00DC] > 'ü'
+ [SHIFT U_00DC] > 'Ü'
+ [K_I] > 'ı'
+ [SHIFT K_I] > 'I'
