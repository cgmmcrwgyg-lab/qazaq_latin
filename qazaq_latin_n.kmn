store(&VERSION) "10.0"
store(&NAME) "Qazaq Latin N"
store(&KEYBOARDVERSION) "1.0"
store(&TARGETS) "any"
store(&COPYRIGHT) "Qazaq Translit"
store(&LAYOUTFILE) "qazaq_latin_n.keyman-touch-layout"

begin Unicode > use(Main)

group(Main) using keys

c Default layer = UPPERCASE (as in your touch layout)
c Shift layer = lowercase

+ [K_A] > 'A'
+ [SHIFT K_A] > 'a'
+ [K_AUML] > 'Ä'
+ [SHIFT K_AUML] > 'ä'
+ [K_B] > 'B'
+ [SHIFT K_B] > 'b'
+ [K_D] > 'D'
+ [SHIFT K_D] > 'd'
+ [K_E] > 'E'
+ [SHIFT K_E] > 'e'
+ [K_F] > 'F'
+ [SHIFT K_F] > 'f'
+ [K_G] > 'G'
+ [SHIFT K_G] > 'g'
+ [K_GBREVE] > 'Ğ'
+ [SHIFT K_GBREVE] > 'ğ'

+ [K_H] > 'H'
+ [SHIFT K_H] > 'h'
+ [K_I_DOTTED] > 'İ'
+ [SHIFT K_I_DOTTED] > 'i'
+ [K_I] > 'I'
+ [SHIFT K_I] > 'ı'
+ [K_J] > 'J'
+ [SHIFT K_J] > 'j'
+ [K_K] > 'K'
+ [SHIFT K_K] > 'k'
+ [K_L] > 'L'
+ [SHIFT K_L] > 'l'
+ [K_M] > 'M'
+ [SHIFT K_M] > 'm'
+ [K_N] > 'N'
+ [SHIFT K_N] > 'n'

+ [K_NTILDE] > 'Ñ'
+ [SHIFT K_NTILDE] > 'ñ'
+ [K_O] > 'O'
+ [SHIFT K_O] > 'o'
+ [K_OUML] > 'Ö'
+ [SHIFT K_OUML] > 'ö'
+ [K_P] > 'P'
+ [SHIFT K_P] > 'p'
+ [K_Q] > 'Q'
+ [SHIFT K_Q] > 'q'
+ [K_R] > 'R'
+ [SHIFT K_R] > 'r'
+ [K_S] > 'S'
+ [SHIFT K_S] > 's'
+ [K_SCED] > 'Ş'
+ [SHIFT K_SCED] > 'ş'

+ [K_T] > 'T'
+ [SHIFT K_T] > 't'
+ [K_U] > 'U'
+ [SHIFT K_U] > 'u'
+ [K_UMACRON] > 'Ū'
+ [SHIFT K_UMACRON] > 'ū'
+ [K_UUML] > 'Ü'
+ [SHIFT K_UUML] > 'ü'
+ [K_V] > 'V'
+ [SHIFT K_V] > 'v'
+ [K_Y] > 'Y'
+ [SHIFT K_Y] > 'y'
+ [K_Z] > 'Z'
+ [SHIFT K_Z] > 'z'
