+ [NCAPS K_I] > 'ı'
+ [SHIFT NCAPS K_I] > 'I'
+ [CAPS K_I] > 'I'
+ [SHIFT CAPS K_I] > 'ı'

c Digits - numeric layer Row 1
+ [NCAPS K_1] > '1'
+ [NCAPS K_2] > '2'
+ [NCAPS K_3] > '3'
+ [NCAPS K_4] > '4'
+ [NCAPS K_5] > '5'
+ [NCAPS K_6] > '6'
+ [NCAPS K_7] > '7'
+ [NCAPS K_8] > '8'
+ [NCAPS K_9] > '9'
+ [NCAPS K_0] > '0'

c Punctuation - numeric layer Row 2 + Row 3
+ [NCAPS U_002D] > '-'
+ [NCAPS U_002F] > '/'
+ [NCAPS U_003A] > ':'
+ [NCAPS U_003B] > ';'
+ [NCAPS U_0028] > '('
+ [NCAPS U_0029] > ')'
+ [NCAPS U_00A3] > '£'
+ [NCAPS U_0026] > '&'
+ [NCAPS U_0040] > '@'
+ [NCAPS U_0022] > '"'
+ [NCAPS U_002E] > '.'
+ [SHIFT NCAPS U_002E] > '.'
+ [CAPS U_002E] > '.'
+ [SHIFT CAPS U_002E] > '.'
+ [NCAPS U_002C] > ','
+ [SHIFT NCAPS U_002C] > ','
+ [CAPS U_002C] > ','
+ [SHIFT CAPS U_002C] > ','
+ [NCAPS U_003F] > '?'
+ [NCAPS U_0021] > '!'
+ [NCAPS U_0027] > "'"

c Space
+ [NCAPS K_SPACE] > ' '

c Symbols - symbol layer Row 1 + Row 2
+ [NCAPS U_005B] > '['
+ [NCAPS U_005D] > ']'
+ [NCAPS U_007B] > '{'
+ [NCAPS U_007D] > '}'
+ [NCAPS U_0023] > '#'
+ [NCAPS U_0025] > '%'
+ [NCAPS U_005E] > '^'
+ [NCAPS U_002A] > '*'
