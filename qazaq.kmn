store(&VERSION) '10.0'
store(&NAME) 'Qazaq'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'
store(&COPYRIGHT) 'Qazaq Translit'
store(&LAYOUTFILE) 'qazaq.keyman-touch-layout'
begin Unicode > use(main)

group(main) using keys

c Double-space = period + space, like Apple
' ' + [NCAPS K_SPACE] > '.' ' '

c Auto-capitalise after . ? ! and newline - must be BEFORE normal lowercase rules
c After '. '
'.' ' ' + [NCAPS K_Q] > 'Q'
