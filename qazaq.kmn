+ [NCAPS U_007C] > '|'
+ [NCAPS U_007E] > '~'
+ [NCAPS U_003C] > '<'
+ [NCAPS U_003E] > '>'
+ [NCAPS U_20AC] > '€'
+ [NCAPS U_00A5] > '¥'
+ [NCAPS U_0024] > '$'
+ [NCAPS U_00A2] > '¢'
