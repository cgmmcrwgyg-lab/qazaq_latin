store(&VERSION) '15.0'
store(&NAME) 'Qazaq'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'
store(&COPYRIGHT) 'Qazaq Translit'
store(&LAYOUTFILE) 'qazaq.keyman-touch-layout'
begin Unicode > use(main)
begin NewContext > use(NewContext)
begin PostKeystroke > use(PostKeystroke)

c Which keys are letters - all 34 Qazaq letters
store(&CasedKeys) [K_Q] [K_W] [K_E] [K_R] [K_T] [K_Y] [K_U] [U_0130] [K_O] [U_00D6] [K_P] [K_A] [U_00C4] [K_S] [U_015E] [K_D] [K_F] [K_G] [U_011E] [K_H] [K_J] [K_K] [K_L] [K_Z] [K_X] [K_C] [K_V] [K_B] [K_N] [U_00D1] [K_M] [U_016A] [U_00DC] [K_I]

group(NewContext) readonly
nomatch > use(detectStartOfSentence)

group(PostKeystroke) readonly
if(&layer = 'caps') > context
if(&layer = 'numeric') > context
if(&layer = 'symbol') > context
if(&newLayer = "") > use(detectStartOfSentence)

group(detectStartOfSentence) readonly
store(sentencePunctuation) '.?!'
store(whitespace) ' ' U+00A0 U+000D U+000A U+0009
store(newline) U+000A U+000D
nul > layer('shift')
any(newline) > layer('shift')
any(sentencePunctuation) any(whitespace) > layer('shift')
any(sentencePunctuation) any(whitespace) any(whitespace) > layer('shift')
any(sentencePunctuation) any(newline) > layer('shift')
nomatch > layer('default')

group(main) using keys

c Double-space = period + space, like Apple. PostKeystroke then sees '. ' and switches to shift
' ' + [NCAPS K_SPACE] > '.' ' '

+ [NCAPS K_Q] > 'q'
+ [SHIFT NCAPS K_Q] > 'Q'
+ [CAPS K_Q] > 'Q'
+ [SHIFT CAPS K_Q] > 'q'
+ [NCAPS K_W] > 'w'
+ [SHIFT NCAPS K_W] > 'W'
+ [CAPS K_W] > 'W'
+ [SHIFT CAPS K_W] > 'w'
+ [NCAPS K_E] > 'e'
+ [SHIFT NCAPS K_E] > 'E'
+ [CAPS K_E] > 'E'
+ [SHIFT CAPS K_E] > 'e'
+ [NCAPS K_R] > 'r'
+ [SHIFT NCAPS K_R] > 'R'
+ [CAPS K_R] > 'R'
+ [SHIFT CAPS K_R] > 'r'
+ [NCAPS K_T] > 't'
+ [SHIFT NCAPS K_T] > 'T'
+ [CAPS K_T] > 'T'
+ [SHIFT CAPS K_T] > 't'
